# Agent Hub — environment template
# Real values go in .env (gitignored); never commit real hostnames, tokens,
# or credentials (R-09). Placeholders only.

# — backend (composition root, backend/src/main.ts) —
# HUB_PORT: dev default 8790; production sets it explicitly (the VM pins
# HUB_PORT=8791) and it MUST match the Cloudflare tunnel's ingress target —
# a restart on a different port would break the tunnel silently (ADR-002).
HUB_PORT=8790
HUB_DB_PATH=./hub.sqlite
# Bearer credential for localhost/programmatic callers (and the SPA's local
# fallback). Behind Cloudflare Access, browsers authenticate via the verified
# Access JWT instead (below), so a human never pastes this.
HUB_API_TOKEN=choose-a-long-random-token
AGENTS_CONFIG=./agents.example.yaml
# — browser auth via Cloudflare Access (ADR-011, Q-07) —
# Set both to have the backend VERIFY the signed Cf-Access-Jwt-Assertion for
# browser traffic (RS256 vs the team JWKS + aud + iss + expiry). Absent →
# bearer-only (dev/local/CI). Deployment identifiers — never commit the real
# values (R-09); they live in the VM .env.
# HUB_ACCESS_ISSUER=https://<team>.cloudflareaccess.com
# HUB_ACCESS_AUD=<access-application-aud-tag>
# Built frontend to serve same-origin with /api (ADR-002 single hostname).
# Defaults to ../frontend/dist beside the repo; set only to override. Serving
# is skipped if the dir has no index.html (API-only boot). Run `npm run build`
# in frontend/ at deploy so the dist exists.
# HUB_STATIC_DIR=../frontend/dist

# Runtime stack (config/runtime.ts): fake (default, offline, no credentials)
# or real (Increment 2 — everything below becomes required).
HUB_RUNTIME=fake

# — fake runtime only —
HUB_FAKE_FIXTURES_DIR=../docs/spikes/S-01/fixtures/run-20260714T142930Z

# — real runtime only (HUB_RUNTIME=real) —
# The seam is consumed over localhost in the deployed topology (ADR-002).
SEAM_BASE_URL=http://127.0.0.1:3001
# Dedicated substrate account for the Hub — the execution identity, not the
# functional owner (ADR-007). Must be admin-flagged upstream for exec- and
# create-on-behalf to be authorized.
SEAM_USERNAME=agenthub
SEAM_PASSWORD=placeholder
# Claude subscription OAuth token (Q-10); rides each run's exec env only —
# never persisted, never logged (SEC-07, 13 §5).
CLAUDE_CODE_OAUTH_TOKEN=placeholder
# Owner's admin-account user id (ADR-007, N2). Set → the Hub creates new
# project sessions IN THE OWNER'S ACCOUNT on their behalf (shared-terminal
# #420), so they are visible and usable there. Unset → sessions are
# self-owned by the Hub's account (pre-#420 behavior). A deployment
# identifier — never commit the real value (R-09).
# SEAM_OWNER_USER_ID=placeholder-owner-uuid

# — lagging budget estimate (B3-06, ADR-003, R-06) —
# USD per 1M tokens; the runner trips budget_exceeded when the streamed-usage
# estimate crosses a run's budgetUsd cap. Defaults are conservative (a runaway
# cap, not a billing figure); override per deployment/model.
# BUDGET_USD_PER_MTOK_INPUT=3
# BUDGET_USD_PER_MTOK_OUTPUT=15
# BUDGET_USD_PER_MTOK_CACHE_READ=0.3
# BUDGET_USD_PER_MTOK_CACHE_WRITE=3.75

# — backups (B3-04, OPS-01/02): none (default) | local | r2 —
BACKUP_SINK=none
# BACKUP_INTERVAL_MS=21600000   # snapshot cadence; default 6 h (09 §5)
# local sink:
# BACKUP_LOCAL_DIR=./snapshots
# r2 sink (Cloudflare R2 over the S3 API; scoped Object-Read-&-Write token):
# R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# R2_BUCKET=<bucket-name>
# R2_ACCESS_KEY_ID=placeholder
# R2_SECRET_ACCESS_KEY=placeholder
