# Agent Hub — environment template
# Real values go in .env (gitignored); never commit real hostnames, tokens,
# or credentials (R-09). Placeholders only.

# — backend (composition root, backend/src/main.ts) —
HUB_PORT=8790
HUB_DB_PATH=./hub.sqlite
HUB_API_TOKEN=choose-a-long-random-token
AGENTS_CONFIG=./agents.example.yaml

# Runtime stack (config/runtime.ts): fake (default, offline, no credentials)
# or real (Increment 2 — everything below becomes required).
HUB_RUNTIME=fake

# — fake runtime only —
HUB_FAKE_FIXTURES_DIR=../docs/spikes/S-01/fixtures/run-20260714T142930Z

# — real runtime only (HUB_RUNTIME=real) —
# The seam is consumed over localhost in the deployed topology (ADR-002).
SEAM_BASE_URL=http://127.0.0.1:3001
# Dedicated substrate account for the Hub (Q-04) — never a personal account.
SEAM_USERNAME=agenthub
SEAM_PASSWORD=placeholder
# Claude subscription OAuth token (Q-10); rides each run's exec env only —
# never persisted, never logged (SEC-07, 13 §5).
CLAUDE_CODE_OAUTH_TOKEN=placeholder
